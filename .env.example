# Copy to .env and fill in. Never commit the real values.
#
#   Camunda Console → cluster Rec_clients_CDG → API → Create a new client
#   (scopes: Zeebe, Tasklist, Operate)

CAMUNDA_ENABLED=true
CAMUNDA_CLUSTER_ID=
CAMUNDA_REGION=
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=

# Signing key for the API tokens — at least 32 characters, different per environment.
JWT_SECRET=

# Optional integrations
ML_ENABLED=false
ML_BASE_URL=http://localhost:8000
MAIL_ENABLED=false

# Demo data — turn both off for anything other than a demonstration.
SEED_USERS=true
SEED_CLAIMS=true
DEMO_PASSWORD=Cdg@2026

# PostgreSQL (only used with SPRING_PROFILES_ACTIVE=postgres)
DB_URL=jdbc:postgresql://localhost:5432/claims
DB_USER=claims
DB_PASSWORD=claims
