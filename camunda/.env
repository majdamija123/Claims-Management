# Pinned to the exact version this project's backend client (io.camunda:camunda-client-java,
# see backend/pom.xml) was verified against. Camunda only ships a Docker image for select
# patch releases, so this is not simply "the latest 8.9.x" - it is the highest 8.9 patch that
# actually has a published camunda/camunda image.
CAMUNDA_VERSION=8.9.11

# File-based H2 storage (default) - no Elasticsearch/OpenSearch needed for local development.
# See camunda/README.md to switch to Postgres/MySQL/etc.
ORCHESTRATION_CONFIG_FILE=application-h2.yaml

# Without this, the container's default zone is a named region (e.g. "GMT") rather than a
# fixed UTC offset. The BPMN's zeebe:taskSchedule fallback expressions call FEEL's
# string(now() + duration(...)) to compute a due date, and FEEL renders a named-zone
# date-time as "<local-date-time>@<zone>" (e.g. "2026-09-02T23:43:31.743@GMT") instead of
# ISO-8601 - which Zeebe's own dueDate parser then rejects, raising an incident on the next
# user task ("Invalid date-time format '...@GMT'"). Pinning TZ=UTC makes now() resolve to a
# fixed offset, which FEEL renders as "...Z" instead.
TZ=UTC
