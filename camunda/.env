# Pinned to the exact version this project's backend client (io.camunda:camunda-client-java,
# see backend/pom.xml) was verified against. Camunda only ships a Docker image for select
# patch releases, so this is not simply "the latest 8.9.x" - it is the highest 8.9 patch that
# actually has a published camunda/camunda image.
CAMUNDA_VERSION=8.9.11

# File-based H2 storage (default) - no Elasticsearch/OpenSearch needed for local development.
# See camunda/README.md to switch to Postgres/MySQL/etc.
ORCHESTRATION_CONFIG_FILE=application-h2.yaml

# Keep the engine's clock on UTC, matching the java.time.Instant deadlines the backend sends.
# Also keeps the taskSchedule fallback expressions (string(now() + duration(...)), only reached
# when the backend has not supplied an sla* variable) from rendering a named-zone date-time as
# "<local-date-time>@<zone>", which is not ISO-8601 and Zeebe's own dueDate parser rejects.
TZ=UTC
